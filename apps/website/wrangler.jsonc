{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mukuchi-blog",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "blog.setobox.me", "custom_domain": true, "zone_name": "setobox.me" }
  ],
  "assets": { "html_handling": "drop-trailing-slash" },
  "d1_databases": [
    {
      "binding": "ADMIN_DB",
      "database_name": "mukuchi-admin",
      "database_id": "3453b53f-aba4-43cf-8103-f5a69fb59f87",
      "migrations_dir": "migrations/admin",
      "remote": false
    },
    {
      "binding": "DB",
      "database_name": "mukuchi-content",
      "database_id": "c8f87923-1ca6-4f8c-94b6-644f621d19db"
    },
    {
      "binding": "STATS_DB",
      "database_name": "mukuchi-stats",
      "database_id": "d9948aa8-0882-494e-a559-fe7d381a4902",
      "migrations_dir": "migrations/stats",
      "remote": false
    }
  ],
  "r2_buckets": [
    { "binding": "ADMIN_ASSETS", "bucket_name": "mukuchi-draft-assets", "remote": false },
    { "binding": "AUDIO_ASSETS", "bucket_name": "mukuchi-audio", "remote": false }
  ],
  "workflows": [{ "name": "mukuchi-article-audio", "binding": "ARTICLE_AUDIO_WORKFLOW", "class_name": "ArticleAudioWorkflow" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
