# 可选：仅供 GitHub 卡片构建快照使用，不能提交真实令牌。
MUKUCHI_GITHUB_TOKEN=

# 统计采集开关在后台设置，默认开启。真实密钥仅放在被忽略的 .env 中。
NUXT_STATS_HASH_SECRET=
NUXT_STATS_ADMIN_TOKEN=
# 可选；默认 apps/website/.data/stats.sqlite。使用绝对路径。
# NUXT_STATS_DATABASE_PATH=

# 后台：开发模式仅回环地址免登录；生产必须配置账号凭据和管理员邮箱。
# 对话助手由后台配置并通过能力测试后启用，无需环境开关。
# AI 密钥保护：32 字节随机数据的 Base64；本地与生产使用不同值。
# NUXT_AI_ENCRYPTION_KEY=
# 账号和后台固定可用；管理员邮箱以逗号分隔，忽略大小写。
NUXT_AUTH_ADMIN_EMAILS=
# MU³ ID：以下均为服务端私有配置。开发客户端需在账号中心独立登记。
NUXT_APP_ORIGIN=http://localhost:3333
NUXT_OIDC_ISSUER=https://id.seto.box/api/auth
NUXT_OIDC_CLIENT_ID=mukuchi-dev
NUXT_OIDC_CLIENT_SECRET=
NUXT_OIDC_REDIRECT_URI=http://localhost:3333/api/auth/sso/callback
NUXT_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3333/
NUXT_OIDC_SCOPES="openid profile email"
# 独立随机 32 字节 Base64，用于加密会话中的 ID token；不能复用 OIDC 密钥。
NUXT_AUTH_SESSION_KEY=
# 固定有效期（秒），不滑动续期；默认 8 小时，允许 300–604800。
NUXT_AUTH_SESSION_MAX_AGE=28800
# 独立 fine-grained PAT，仅目标仓库 Contents 写、Actions 读。
NUXT_GITHUB_PUBLISH_TOKEN=
NUXT_GITHUB_REPOSITORY=setobox/mukuchi
NUXT_GITHUB_BRANCH=main
# 登录回调必须精确登记；不能从请求 Host 或公共站点配置推断。
# 生产配置与客户端 JSON 见 AUTH.md。
# NUXT_ADMIN_DATABASE_PATH=
# NUXT_ADMIN_ASSETS_DIRECTORY=

# giscus 公开配置；需开启 Discussions 并安装 giscus。
NUXT_PUBLIC_GISCUS_REPO=setobox/mukuchi
NUXT_PUBLIC_GISCUS_REPO_ID=
NUXT_PUBLIC_GISCUS_CATEGORY_ID=

# 音频默认关闭；生成只在已配置 Workflows、D1、R2 的 Workers 中执行。
# 部署同步令牌：至少 32 字符的随机值，生产 Worker / Actions Secret 保持一致。
# NUXT_AUDIO_SYNC_TOKEN=
