# 按功能分组、组内按名称排序。复制为 .env 后填写；真实值不能提交。
# PUBLIC_ 配置可进入浏览器和预渲染页面；其他业务配置仅供服务端使用。
# 本地使用 .env；生产运行时使用 Worker Variables / Secrets。

# ── 站点与公开评论 ──
# 评论分类 ID，启用评论必填；GitHub 对应 MUKUCHI_GISCUS_CATEGORY_ID。
PUBLIC_GISCUS_CATEGORY_ID=
# 评论仓库，与仓库 ID、分类 ID 配套；GitHub 对应 MUKUCHI_GISCUS_REPO。
PUBLIC_GISCUS_REPO=setobox/mukuchi
# 评论仓库 ID，启用评论必填；GitHub 对应 MUKUCHI_GISCUS_REPO_ID。
PUBLIC_GISCUS_REPO_ID=
# 可选：公开站点地址，默认 https://blog.seto.box；修改后须重建静态页面。
# PUBLIC_SITE_URL=https://blog.seto.box

# ── 登录与会话（私有；生产使用 Worker Secrets） ──
# 登录必填：本站可信源；开发客户端需独立登记。
# APP_ORIGIN=http://localhost:3333
# 管理员邮箱，逗号分隔、忽略大小写；生产后台必填。
AUTH_ADMIN_EMAILS=
# 登录必填：独立 32 字节 Base64，用于加密 ID token。改名保留原值。
# 本地与生产使用各自原值，不能复用 OIDC 密钥。
# AUTH_SESSION_KEY=
# 可选：会话固定有效期，默认 28800 秒，允许 300–604800。
# AUTH_SESSION_MAX_AGE=28800
# 开发未配置 OIDC 时保留本机免登录；启用时一次填齐整组，不复用生产客户端。
# OIDC_CLIENT_ID=mukuchi-dev
# 账号中心签发的客户端密钥，启用 OIDC 必填。
# OIDC_CLIENT_SECRET=
# 可选：默认 https://id.seto.box/api/auth，须与 Discovery issuer 相同。
# OIDC_ISSUER=https://id.seto.box/api/auth
# 退出回调，启用 OIDC 必填；精确匹配登记值，包括尾斜杠。
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3333/
# 登录回调，启用 OIDC 必填；不能从请求 Host 推断。
# OIDC_REDIRECT_URI=http://localhost:3333/api/auth/sso/callback
# 可选：固定为 openid profile email，不申请额外权限。
# OIDC_SCOPES="openid profile email"

# ── 管理与发布（私有） ──
# 可选：文章发布分支，默认 main；生产使用 Worker Secret。
# GITHUB_BRANCH=main
# 生产文章发布必填：仅目标仓库 Contents 写、Actions 读的 fine-grained PAT。
GITHUB_PUBLISH_TOKEN=
# 可选：文章发布仓库，默认 setobox/mukuchi；生产使用 Worker Secret。
# GITHUB_REPOSITORY=setobox/mukuchi

# ── AI 与音频（私有） ──
# AI / 助手 / 音频凭据解密必填：32 字节 Base64。改名保留原值。
# 本地与生产各用原值；生产 Worker 与 GitHub 同名 Secret 必须一致。
AI_ENCRYPTION_KEY=
# 生产音频清单同步必填：至少 32 字符；Worker 与 GitHub 同名 Secret 一致。
# AUDIO_SYNC_TOKEN=
# 功能开关、模型供应商和语音参数由后台管理，不再使用环境开关。

# ── 统计（私有；生产使用 Worker Secrets） ──
# 可选：统计 Bearer 查询令牌，本地 stats:smoke 需要；无令牌仍支持管理员会话。
STATS_ADMIN_TOKEN=
# 统计采集必填：至少 32 字符；改名保留原值。
STATS_HASH_SECRET=

# ── 本地路径与构建工具 ──
# 路径仅供 Node 本地运行，使用绝对路径；Workers 使用 D1 / R2 绑定。
# 私有图片目录，默认 apps/website/.data/admin-assets。
# ADMIN_ASSETS_DIRECTORY=
# 后台 SQLite，默认 apps/website/.data/admin.sqlite。
# ADMIN_DATABASE_PATH=
# 公开文章图片目录，默认 apps/website/public/images。
# ADMIN_IMAGES_DIRECTORY=
# Markdown 文章目录，默认 content/posts。
# ADMIN_POSTS_DIRECTORY=
# 可选：GitHub 卡片构建快照令牌；CI 自动注入临时 GitHub token。
# MUKUCHI_GITHUB_TOKEN=
# 可选：验收目标地址；生产 Actions Variable 为 https://blog.seto.box。
# MUKUCHI_SMOKE_URL=http://localhost:3333
# 统计 SQLite，默认 apps/website/.data/stats.sqlite。
# STATS_DATABASE_PATH=
